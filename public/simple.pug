doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Simple 3D Chat | PromptSCAD - AI-Powered 3D Modeling
    
    // SEO Meta Tags
    meta(name="description" content="Simple AI-powered 3D modeling interface. Chat with AI to create 3D models instantly. No coding required - just describe what you want to build.")
    meta(name="keywords" content="AI 3D modeling, simple CAD tool, chat 3D design, no-code 3D modeling, AI assistant 3D, beginner 3D design")
    meta(name="author" content="PromptSCAD")
    meta(name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1")
    meta(name="theme-color" content="#2563eb")
    link(rel="canonical" href="https://promptscad.com/simple.html")
    
    // Open Graph / Facebook Meta Tags
    meta(property="og:type" content="website")
    meta(property="og:url" content="https://promptscad.com/simple.html")
    meta(property="og:title" content="Simple 3D Chat | PromptSCAD - AI-Powered 3D Modeling")
    meta(property="og:description" content="Simple AI-powered 3D modeling interface. Chat with AI to create 3D models instantly. No coding required - just describe what you want to build.")
    meta(property="og:image" content="https://promptscad.com/main/sample.png")
    
    // Twitter Meta Tags
    meta(name="twitter:card" content="summary_large_image")
    meta(name="twitter:url" content="https://promptscad.com/simple.html")
    meta(name="twitter:title" content="Simple 3D Chat | PromptSCAD - AI-Powered 3D Modeling")
    meta(name="twitter:description" content="Simple AI-powered 3D modeling interface. Chat with AI to create 3D models instantly. No coding required - just describe what you want to build.")
    meta(name="twitter:image" content="https://promptscad.com/main/sample.png")
    
    // Favicon
    link(rel="icon" href="/favicon.ico" type="image/x-icon")
    
    // Styling
    link(rel="stylesheet" href="/styles.css")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet")
    
    // 3D Libraries
    script(src="https://cdn.babylonjs.com/babylon.js")
    script(src="https://cdn.babylonjs.com/loaders/babylon.stlFileLoader.min.js")
    script(src="https://cdn.jsdelivr.net/npm/ace-builds@1.28.0/src-min-noconflict/ace.min.js")

    // Simple layout specific styles
    link(rel="stylesheet" href="/simple.css")

  body
    // Navigation Bar
    header.fixed-header
      nav.navbar(role="navigation" aria-label="Main navigation")
        .menu-toggle#mobile-menu
          span.bar
          span.bar
          span.bar
        a(href="/" style="text-decoration: none; color: inherit;")
          .logo
            h1 PromptSCAD Simple
        ul.nav-list
          li.nav-item
            a(href="#") File
            .dropdown
              a(href="#" onclick="newDesign(event)")
                i.bi.bi-plus
                | New
                span.shortcut Ctrl + N
              input(type="file" id="fileInput" style="display:none;")
              a(href="#" onclick="openDesign(event)")
                i.bi.bi-folder
                | Open
                span.shortcut Ctrl + O
              a(href="#" onclick="saveDesign(event)")
                i.bi.bi-save
                | Save
                span.shortcut Ctrl + S
              a(href="#" onclick="downloadSTL(event)")
                i.bi.bi-download
                | Download STL
              a(href="#" onclick="downloadSCAD(event)")
                i.bi.bi-download
                | Download SCAD
          li.nav-item
            a(href="#") Tools
            .dropdown
              a(href="#" onclick="showStorageStats(event)")
                i.bi.bi-info-circle
                | Storage Info
              a(href="#" onclick="clearStorageCache(event)")
                i.bi.bi-trash
                | Clear Cache
          li.nav-item
            a(href="/main" onclick="handleModeSwitch(event, 'main')") Advanced Mode
        .flex-spacer

    // Main Container
    main.simple-container(role="main" aria-label="Simple 3D Chat Interface")
      // Side Panel - Chat History
      .side-panel.collapsed#chatHistoryPanel(style="position: fixed; left: 0; top: 40px; height: calc(100vh - 40px); z-index: 900;")
        .side-panel-header
          h3 Chat History
          button.collapse-toggle#historyCollapseToggle
            i.bi.bi-chevron-right
        .side-panel-content
          ul.chat-history-list
            li.chat-history-item Create a red cube with rounded corners
            li.chat-history-item Make it bigger and add a hole
            li.chat-history-item Add text on the side
            li.chat-history-item Change to blue color
      
      // Main content wrapper with margin for side panel
      div(style="margin-left: 300px; width: calc(100% - 300px);")
        // Chat Section
        .simple-chat-section
          .simple-chat-container
            h2.simple-chat-title AI 3D Model Creator
            p.simple-chat-subtitle Describe what you want to create and watch it come to life in 3D
            
            .simple-editor-container
              #simpleChatEditor
              .simple-placeholder-text Try: "Create a red cube" then "add rounded corners" or "make it bigger" - each request builds on the previous model!
            
            .simple-chat-controls
              button#simpleChatSubmit.simple-chat-submit
                i.bi.bi-send
                span.button-text Create 3D Model

        // Parameters Section
        .simple-parameters-section#parametersSection
          .parameter-header.collapsed#parameterHeader
            h3.parameter-header-title
              i.bi.bi-sliders
              | Edit Parameters
            i.bi.bi-chevron-down.parameter-toggle-icon
          .parameter-content.collapsed#parameterContent
            #parametersContainer
              // Parameter form will be dynamically inserted here

        // 3D Render Section
        .simple-3d-section
          #loadingScreen
          canvas#renderCanvas

    // Side Panel JavaScript
    script(src="/simple-panel.js")

    // App Scripts
    script(src="/openscad.js" type="module")
    script(src="/openscad.fonts.js" type="module")
    script(src="/openscad.mcad.js" type="module")
    script(type="module" src="/src/utils/storage/index.js")
    script(type="module" src="/src/ui/storageStats.js")
    script(type="module" src="/src/simple.js")
