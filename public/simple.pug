doctype html
html(lang="en")
  head
    script(data-cfasync="false" type="text/javascript" src="monetag.js")
    include template/head.pug
    - var title = "Simple 3D Chat | PromptSCAD - AI-Powered 3D Modeling"
    - var description = "Simple AI-powered 3D modeling interface. Chat with AI to create 3D models instantly. No coding required - just describe what you want to build."
    - var keywords = "AI 3D modeling, simple CAD tool, chat 3D design, no-code 3D modeling, AI assistant 3D, beginner 3D design"
    - var canonical = "https://promptscad.com/simple.html"

    // Mobile viewport configuration
    meta(name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no")

    // Simple layout specific styles
    link(rel="stylesheet" href="/simple.css")

  body
    // Navigation Bar
    header.fixed-header
      nav.navbar(role="navigation" aria-label="Main navigation")
        .menu-toggle#mobile-menu
          span.bar
          span.bar
          span.bar
        a(href="/" style="text-decoration: none; color: inherit;")
          .logo
            h1 PromptSCAD Simple
        ul.nav-list
          li.nav-item
            a(href="#") File
            .dropdown
              a(href="#" onclick="newDesign(event)")
                i.bi.bi-plus
                | New
                span.shortcut Ctrl + N
              input(type="file" id="fileInput" style="display:none;")
              a(href="#" onclick="openDesign(event)")
                i.bi.bi-folder
                | Open
                span.shortcut Ctrl + O
              a(href="#" onclick="saveDesign(event)")
                i.bi.bi-save
                | Save
                span.shortcut Ctrl + S
              a(href="#" onclick="downloadSTL(event)")
                i.bi.bi-download
                | Download STL
              a(href="#" onclick="downloadSCAD(event)")
                i.bi.bi-download
                | Download SCAD
          li.nav-item
            a(href="#") Tools
            .dropdown
              a(href="#" onclick="showStorageStats(event)")
                i.bi.bi-info-circle
                | Storage Info
              a(href="#" onclick="clearStorageCache(event)")
                i.bi.bi-trash
                | Clear Cache
          li.nav-item
            a(href="/main.html" onclick="handleModeSwitch(event, 'main')") Advanced Mode
        .flex-spacer

    // Main Container
    main.simple-container(role="main" aria-label="Simple 3D Chat Interface")
      // Side Panel - Chat History (using template)
      include template/side-panel.pug
      +side-panel("chatHistoryPanel", "collapsed", "position: fixed; left: 0; top: 40px; height: calc(100vh - 40px); z-index: 900;", "Chat History")
      
      // Main content wrapper with responsive margin for side panel
      .main-content-wrapper
        // Chat Section
        .simple-chat-section
          .simple-chat-container
            h2.simple-chat-title AI 3D Model Creator
            p.simple-chat-subtitle Describe what you want to create and watch it come to life in 3D
            
            .simple-editor-container
              #simpleChatEditor
              .simple-placeholder-text Try: "Create a red cube" then "add rounded corners" or "make it bigger" - each request builds on the previous model!
            
            .simple-chat-controls
              button#simpleChatSubmit.simple-chat-submit
                i.bi.bi-magic.button-icon
                span.button-text Generate 3D Model

        // Parameters Section
        .simple-parameters-section#parametersSection
          .parameter-header.collapsed#parameterHeader
            h3.parameter-header-title
              i.bi.bi-sliders
              | Edit Parameters
            i.bi.bi-chevron-down.parameter-toggle-icon
          .parameter-content.collapsed#parameterContent
            #parametersContainer
              // Parameter form will be dynamically inserted here

        // 3D Render Section
        .simple-3d-section
          #loadingScreen
          canvas#renderCanvas

    // Side Panel JavaScript
    script(src="/simple-panel.js")

    // App Scripts
    script(src="/openscad.js" type="module")
    script(src="/openscad.fonts.js" type="module")
    script(src="/openscad.mcad.js" type="module")
    script(type="module" src="/src/utils/storage/index.js")
    script(type="module" src="/src/ui/storageStats.js")
    script(type="module" src="/src/simple.js")
