doctype html
html(lang="en")
  head
    //- Load advertisements script unless disabled
    if hasAds
      script(data-cfasync="false" type="text/javascript" src="monetag.js")
    include template/head.pug
    - var title = "3D Model Gallery | PromptSCAD - Browse AI-Generated Designs"
    - var description = "Browse our collection of AI-generated 3D models. View, explore, and download STL files created with PromptSCAD's AI-powered OpenSCAD generator."
    - var keywords = "3D model gallery, STL files, AI-generated designs, OpenSCAD models, 3D printing gallery, CAD model showcase"
    - var canonical = "https://promptscad.com/gallery.html"

    // Mobile viewport configuration
    meta(name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no")

    // Gallery specific styles
    link(rel="stylesheet" href="/gallery.css")
    // HISTORY BUTTON FIX: Matching clean styles
    link(rel="stylesheet" href="/src/history-clean-fix.css")

  body
    // Main Container - Full Screen Gallery
    main.gallery-container(role="main" aria-label="3D Model Gallery")
      // Gallery Header
      .gallery-header
        h1.gallery-title 3D Model Gallery
        p.gallery-subtitle Browse and explore sample 3D models with STL preview

      // Gallery Content Container
      .gallery-content
        // Gallery Grid - Full width thumbnails only
        .gallery-grid
          // Gallery items will be dynamically populated
          .gallery-empty-state
            i.bi.bi-collection
            h3 No Models Yet
            p Create your first 3D model to see it appear here
            a(href="/simple.html" class="gallery-create-btn")
              i.bi.bi-magic
              | Create Your First Model

    // App Scripts
    script.
      // Global source map error suppression
      (function() {
        const originalWarn = console.warn;
        const originalError = console.error;
        
        // Suppress source map errors globally
        console.warn = function(...args) {
          const message = args[0];
          if (typeof message === 'string' && 
              (message.includes('Source map error') || 
               message.includes('source map') ||
               message.includes('WebAssembly.Module') ||
               message.includes('WEBGL_debug_renderer_info'))) {
            return;
          }
          originalWarn.apply(console, args);
        };
        
        console.error = function(...args) {
          const message = args[0];
          if (typeof message === 'string' && 
              (message.includes('Source map error') || 
               message.includes('source map') ||
               message.includes('WebAssembly.Module') ||
               message.includes('WEBGL_debug_renderer_info'))) {
            return;
          }
          originalError.apply(console, args);
        };
        
        // Also suppress warnings from browser extensions
        window.addEventListener('error', function(e) {
          if (e.message && (
              e.message.includes('Source map error') ||
              e.message.includes('WebAssembly.Module') ||
              e.message.includes('moz-extension')
          )) {
            e.preventDefault();
            e.stopPropagation();
          }
        });
      })();
    
    // Load Babylon.js for STL rendering (same as simple.pug)
    script(src="https://cdn.babylonjs.com/babylon.js")
    script(src="https://cdn.babylonjs.com/loaders/babylonjs.loaders.min.js")
    
    script(src="/openscad.js" type="module")
    script(src="/openscad.fonts.js" type="module")
    script(src="/openscad.mcad.js" type="module")
    script(type="module" src="/src/gallery.js")
