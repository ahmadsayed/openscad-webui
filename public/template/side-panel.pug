//- Side Panel Template
//- This template can be included in both main.pug and simple.pug
//- Parameters:
//-   panelId: ID for the side panel element (default: "chatHistoryPanel")
//-   panelClass: Additional CSS classes for the side panel (default: "collapsed")
//-   panelStyle: Inline styles for the side panel
//-   headerTitle: Title for the panel header (default: "Chat History")

mixin side-panel(panelId = "chatHistoryPanel", panelClass = "collapsed", panelStyle, headerTitle = "Chat History")
  // Side Panel - Chat History
  .side-panel(class=panelClass id=panelId style=panelStyle)
    .side-panel-header
      h3= headerTitle
      button.collapse-toggle(id="historyCollapseToggle")
        i.bi.bi-chevron-right
    .side-panel-content
      ul.chat-history-list
        li.chat-history-item(data-model="cube" data-size="20" data-color="#ff6b6b")
          .item-header
            .item-text Create a red cube with rounded corners
            .item-toggle
              i.bi.bi-chevron-down
          .item-preview
            canvas.preview-canvas(data-preview-id="preview-1")
        li.chat-history-item(data-model="cube" data-size="25" data-color="#4ecdc4")
          .item-header
            .item-text Make it bigger and add a hole
            .item-toggle
              i.bi.bi-chevron-down
          .item-preview
            canvas.preview-canvas(data-preview-id="preview-2")
        li.chat-history-item(data-model="cube" data-size="15" data-color="#45b7d1")
          .item-header
            .item-text Add text on the side
            .item-toggle
              i.bi.bi-chevron-down
          .item-preview
            canvas.preview-canvas(data-preview-id="preview-3")
        li.chat-history-item(data-model="cube" data-size="18" data-color="#96ceb4")
          .item-header
            .item-text Change to blue color
            .item-toggle
              i.bi.bi-chevron-down
          .item-preview
            canvas.preview-canvas(data-preview-id="preview-4")
