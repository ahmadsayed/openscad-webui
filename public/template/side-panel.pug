//- Side Panel Template
//- This template can be included in both main.pug and simple.pug
//- Parameters:
//-   panelId: ID for the side panel element (default: "chatHistoryPanel")
//-   panelClass: Additional CSS classes for the side panel (default: "collapsed")
//-   panelStyle: Inline styles for the side panel
//-   headerTitle: Title for the panel header (default: "Chat History")

mixin side-panel(panelId = "chatHistoryPanel", panelClass = "collapsed", panelStyle, headerTitle = "Chat History")
  // Side Panel - Chat History
  .side-panel(class=panelClass id=panelId style=panelStyle)
    .side-panel-header
      h3= headerTitle
      .side-panel-controls
        button.collapse-toggle(id="historyCollapseToggle" title="Toggle panel")
          i.bi.bi-chevron-right
        button.mobile-close-btn(id="mobileCloseBtn" title="Close panel" style="display: none;")
          i.bi.bi-x
    .side-panel-content
      .chat-history-controls
        button.refresh-history-btn(id="refreshHistoryBtn" title="Refresh history")
          i.bi.bi-arrow-clockwise
          span.button-text Reload
        button.clear-history-btn(id="clearHistoryBtn" title="Clear all history")
          i.bi.bi-trash
          span.button-text Delete
      .chat-history-loading#historyLoading(style="display: none;")
        .loading-spinner
        span Loading history...
      .chat-history-empty#historyEmpty(style="display: none;")
        i.bi.bi-chat-square-text
        p No chat history yet
        small Start creating models to see them here
      ul.chat-history-list#chatHistoryList
        // History items will be dynamically populated by JavaScript
