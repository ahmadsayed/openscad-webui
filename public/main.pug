doctype html
html(lang="en")
  head
    //- Load advertisements script unless disabled
    if hasAds
      script(data-cfasync="false" type="text/javascript" src="monetag.js")

    include template/head.pug
    - var title = "Online OpenSCAD Editor with AI Assistant | PromptSCAD - Free 3D CAD Tool"
    - var description = "Professional online OpenSCAD editor with AI-powered code generation. Create, edit, and render 3D models instantly. Free browser-based CAD tool with real-time preview and STL export."
    - var keywords = "OpenSCAD editor online, AI CAD assistant, 3D modeling browser, parametric design tool, SCAD code editor, online 3D CAD, AI code generation, STL export, WebGL 3D viewer, free CAD software"
    - var canonical = "https://promptscad.com/main.html"

    // Additional meta tags specific to main.pug
    meta(name="language" content="en")
    meta(name="geo.region" content="US")
    meta(name="geo.placename" content="Global")

    if hasAds
      script.
        window.ezstandalone = window.ezstandalone || {};
        ezstandalone.cmd = ezstandalone.cmd || [];
    
    // Structured Data
    script(type="application/ld+json").
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "PromptSCAD Editor",
        "applicationCategory": "DesignApplication",
        "operatingSystem": "Web",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Professional online OpenSCAD editor with AI-powered code generation. Create, edit, and render 3D models instantly. Free browser-based CAD tool with real-time preview and STL export.",
        "featureList": "AI-assisted code editing, 3D model preview, STL export, SCAD file management",
        "browserRequirements": "Requires a modern browser with WebGL support"
      }

  body
    // Navigation Bar
    header
      nav.navbar(role="navigation" aria-label="Main navigation")
        .menu-toggle#mobile-menu
          span.bar
          span.bar
          span.bar
        a(href="/")
          .logo
            h1 PromptSCAD
        ul.nav-list
          li.nav-item
            a(href="#") File
            .dropdown
              a(href="#" onclick="newDesign(event)")
                i.bi.bi-plus
                | New
                span.shortcut Ctrl + N
              input(type="file" id="fileInput" style="display:none;")
              a(href="#" onclick="openDesign(event)")
                i.bi.bi-folder
                | Open
                span.shortcut Ctrl + O
              a(href="#" onclick="saveDesign(event)")
                i.bi.bi-save
                | Save
                span.shortcut Ctrl + S
          li.nav-item
            a(href="#") Design
            .dropdown
              a(href="#")
                i.bi.bi-download
                | Download Model
                i.bi.bi-chevron-right(style="margin-left: auto; float: right;")
                .submenu
                  a(href="#" onclick="downloadSTL(event)")
                    i.bi.bi-box
                    | STL Format
                  a(href="#" onclick="downloadOFF(event)")
                    i.bi.bi-file-code
                    | OFF Format
              a(href="#" onclick="downloadSCAD(event)")
                i.bi.bi-download
                | Download SCAD
          li.nav-item
            a(href="#") Tools
            .dropdown
              a(href="#" onclick="showStorageStats(event)")
                i.bi.bi-info-circle
                | Storage Info
              a(href="#" onclick="clearStorageCache(event)")
                i.bi.bi-trash
                | Clear Cache
          li.nav-item
            a(href="/simple.html" onclick="handleModeSwitch(event, 'simple')") Simple Mode
        .flex-spacer

    // Main Container
    main.container.with-side-panel(role="main" aria-label="OpenSCAD Editor Interface")
      // Side Panel - Chat History (using template)
      include template/side-panel.pug
      +side-panel("chatHistoryPanel", "collapsed", null, "Chat History")

      .split-container
        // Left Panel - Code Editor and Chat
        .split__left
          // SCAD Code Editor
          #editor cube(20, center=true);

          // Vertical Resize Bar
          .resize-bar-vertical

          // Chat Interface
          .chat-container
            .editor-container
              #chatEditor
              .placeholder-text Ask AI to modify the SCAD model, e.g., 'Make a cube with rounded edges'
            .chat-controls
              button#chatSubmit.chat-submit
                i.bi.bi-magic.button-icon
                span.button-text Generate 3D Model

        // Horizontal Resize Bar
        .split__bar

        // Right Panel - 3D Render
        .split__right
          #loadingScreen
          canvas#renderCanvas

    // Side Panel JavaScript
    script(src="/simple-panel.js")

    // App Scripts
    script(src="/openscad.js" type="module")
    script(src="/openscad.fonts.js" type="module")
    script(src="/openscad.mcad.js" type="module")
    script(type="module" src="/src/main.js")
    script(type="module" src="/src/openscadWorker.js")
