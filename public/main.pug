doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Online OpenSCAD Editor with AI Assistant | PromptSCAD - Free 3D CAD Tool
    
    // SEO Meta Tags
    meta(name="description" content="Professional online OpenSCAD editor with AI-powered code generation. Create, edit, and render 3D models instantly. Free browser-based CAD tool with real-time preview and STL export.")
    meta(name="keywords" content="OpenSCAD editor online, AI CAD assistant, 3D modeling browser, parametric design tool, SCAD code editor, online 3D CAD, AI code generation, STL export, WebGL 3D viewer, free CAD software")
    meta(name="author" content="PromptSCAD")
    meta(name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1")
    meta(name="theme-color" content="#2563eb")
    meta(name="language" content="en")
    meta(name="geo.region" content="US")
    meta(name="geo.placename" content="Global")
    link(rel="canonical" href="https://promptscad.com/main.html")
    
    // Open Graph / Facebook Meta Tags
    meta(property="og:type" content="website")
    meta(property="og:url" content="https://promptscad.com/main.html")
    meta(property="og:title" content="Online OpenSCAD Editor with AI Assistant | PromptSCAD - Free 3D CAD Tool")
    meta(property="og:description" content="Professional online OpenSCAD editor with AI-powered code generation. Create, edit, and render 3D models instantly. Free browser-based CAD tool with real-time preview and STL export.")
    meta(property="og:image" content="https://promptscad.com/main/sample.png")
    
    // Twitter Meta Tags
    meta(name="twitter:card" content="summary_large_image")
    meta(name="twitter:url" content="https://promptscad.com/main.html")
    meta(name="twitter:title" content="Online OpenSCAD Editor with AI Assistant | PromptSCAD - Free 3D CAD Tool")
    meta(name="twitter:description" content="Professional online OpenSCAD editor with AI-powered code generation. Create, edit, and render 3D models instantly. Free browser-based CAD tool with real-time preview and STL export.")
    meta(name="twitter:image" content="https://promptscad.com/main/sample.png")
    
    // Favicon
    link(rel="icon" href="/favicon.ico" type="image/x-icon")
    
    // Styling
    link(rel="stylesheet" href="/styles.css")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet")
    
    // 3D and Editor Libraries
    script(src="https://cdn.babylonjs.com/babylon.js")
    script(src="https://cdn.babylonjs.com/loaders/babylon.stlFileLoader.min.js")
    script(src="https://cdn.jsdelivr.net/npm/ace-builds@1.28.0/src-min-noconflict/ace.min.js")

    script.
      window.ezstandalone = window.ezstandalone || {};
      ezstandalone.cmd = ezstandalone.cmd || [];
    
    // Structured Data
    script(type="application/ld+json").
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "PromptSCAD Editor",
        "applicationCategory": "DesignApplication",
        "operatingSystem": "Web",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Professional online OpenSCAD editor with AI-powered code generation. Create, edit, and render 3D models instantly. Free browser-based CAD tool with real-time preview and STL export.",
        "featureList": "AI-assisted code editing, 3D model preview, STL export, SCAD file management",
        "browserRequirements": "Requires a modern browser with WebGL support"
      }

  body
    // Navigation Bar
    header
      nav.navbar(role="navigation" aria-label="Main navigation")
        .menu-toggle#mobile-menu
          span.bar
          span.bar
          span.bar
        a(href="/")
          .logo
            h1 PromptSCAD
        ul.nav-list
          li.nav-item
            a(href="#") File
            .dropdown
              a(href="#" onclick="newDesign(event)")
                i.bi.bi-plus
                | New
                span.shortcut Ctrl + N
              input(type="file" id="fileInput" style="display:none;")
              a(href="#" onclick="openDesign(event)")
                i.bi.bi-folder
                | Open
                span.shortcut Ctrl + O
              a(href="#" onclick="saveDesign(event)")
                i.bi.bi-save
                | Save
                span.shortcut Ctrl + S
          li.nav-item
            a(href="#") Design
            .dropdown
              a(href="#" onclick="downloadSTL(event)")
                i.bi.bi-download
                | Download STL
              a(href="#" onclick="downloadSCAD(event)")
                i.bi.bi-download
                | Download SCAD
          li.nav-item
            a(href="#") Tools
            .dropdown
              a(href="#" onclick="showStorageStats(event)")
                i.bi.bi-info-circle
                | Storage Info
              a(href="#" onclick="clearStorageCache(event)")
                i.bi.bi-trash
                | Clear Cache
          li.nav-item
            a(href="/simple" onclick="handleModeSwitch(event, 'simple')") Simple Mode
        .flex-spacer

    // Main Container
    main.container.with-side-panel(role="main" aria-label="OpenSCAD Editor Interface")
      // Side Panel - Chat History
      .side-panel.collapsed#chatHistoryPanel
        .side-panel-header
          h3 Chat History
          button.collapse-toggle#historyCollapseToggle
            i.bi.bi-chevron-right
        .side-panel-content
          ul.chat-history-list
            li.chat-history-item Create a red cube with rounded corners
            li.chat-history-item Make it bigger and add a hole
            li.chat-history-item Add text on the side
            li.chat-history-item Change to blue color

      .split-container
        // Left Panel - Code Editor and Chat
        .split__left
          // SCAD Code Editor
          #editor cube(20, center=true);

          // Vertical Resize Bar
          .resize-bar-vertical

          // Chat Interface
          .chat-container
            .editor-container
              #chatEditor
              .placeholder-text Ask AI to modify the SCAD model, e.g., 'Make a cube with rounded edges'
            .chat-controls
              button#chatSubmit.chat-submit
                i.bi.bi-send
                span.button-text Send

        // Horizontal Resize Bar
        .split__bar

        // Right Panel - 3D Render
        .split__right
          #loadingScreen
          canvas#renderCanvas

    // Side Panel JavaScript
    script(src="/simple-panel.js")

    // App Scripts
    script(src="/openscad.js" type="module")
    script(src="/openscad.fonts.js" type="module")
    script(src="/openscad.mcad.js" type="module")
    script(type="module" src="/src/main.js")
    script(type="module" src="/src/openscadWorker.js")
